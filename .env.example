APP_ENV=development
APP_BASE_URL=http://localhost:5174
# Set this to any PostgreSQL instance. No credentials are included by default.
DATABASE_URL=
DATABASE_POOL_SIZE=2
DATABASE_MAX_OVERFLOW=1
WEB_DIST_DIR=web/dist
# Generate with: python -m oxybridge.cli keys
SECRET_KEY=
ENCRYPTION_MASTER_KEY=
CRON_SECRET=
SETUP_TOKEN=
EXECUTION_BUDGET_SECONDS=25
SESSION_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=["http://localhost:5174","http://127.0.0.1:5174"]
# JSON arrays of exact approved hostnames. Private network access is blocked by default.
OUTBOUND_PRIVATE_HOSTS=[]
OUTBOUND_ALLOWED_HOSTS=[]
WEBHOOK_MAX_BODY_BYTES=1048576
HTTP_NODE_MAX_RESPONSE_BYTES=5242880
RUN_MAX_SECONDS=3600
RUN_RETENTION_DAYS=90
PAYLOAD_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=365
OTEL_EXPORTER_OTLP_ENDPOINT=
# Required to deliver password resets. Without SMTP, use the local admin reset command.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=oxybridge@localhost
SMTP_STARTTLS=true
# Optional local container database: generate a URL-safe password, never use a shared default.
POSTGRES_PASSWORD=
APP_PORT=8000
# Trust only your reverse proxy's IP(s); never expose a server that trusts arbitrary forwarded headers.
FORWARDED_ALLOW_IPS=127.0.0.1
